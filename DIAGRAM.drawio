                <mxCell id="p2_dev" value="Developer" style="shape=mxgraph.cisco.computers_and_peripherals.pc;sketch=0;html=1;pointerEvents=1;dashed=0;fillColor=#1565C0;strokeColor=#90CAF9;verticalLabelPosition=bottom;verticalAlign=top;align=center;outlineConnect=0;fontColor=#FFFFFF;" parent="1" vertex="1">
