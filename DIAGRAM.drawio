                </mxCell>
                <mxCell id="p2_dev_label" value="&lt;b&gt;1. Developer&lt;/b&gt;&lt;br&gt;Viết code &amp; push lên Git" style="text;html=1;strokeColor=#90CAF9;fillColor=#1565C0;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="50" y="180" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p2_arrow1" value="git push origin main" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#FF8C00;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#B45309;" parent="1" source="p2_dev" target="p2_github" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_github" value="GitHub" style="dashed=0;outlineConnect=0;html=1;align=center;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.webicons.github;gradientColor=#DFDEDE;fontSize=13;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="250" y="90" width="80" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p2_github_label" value="&lt;b&gt;2. GitHub Repository&lt;/b&gt;&lt;br&gt;Source code (monorepo)&lt;br&gt;Branch: main" style="text;html=1;strokeColor=#AAAAAA;fillColor=#333333;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="220" y="195" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p2_arrow2" value="Webhook trigger&lt;br&gt;(on push to main)" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#FF8C00;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#B45309;" parent="1" source="p2_github" target="p2_pipeline" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_pipeline" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codepipeline;" parent="1" vertex="1">
                    <mxGeometry x="450" y="95" width="70" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p2_pipeline_label" value="&lt;b&gt;3. AWS CodePipeline&lt;/b&gt;&lt;br&gt;Orchestrate CI/CD stages&lt;br&gt;Stage: Source → Build → Deploy" style="text;html=1;strokeColor=#7986CB;fillColor=#283593;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="415" y="195" width="140" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p2_arrow3" value="Trigger Build Stage" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#FF8C00;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#B45309;" parent="1" source="p2_pipeline" target="p2_codebuild" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_codebuild" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" parent="1" vertex="1">
                    <mxGeometry x="650" y="95" width="70" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p2_codebuild_label" value="&lt;b&gt;4. AWS CodeBuild&lt;/b&gt;&lt;br&gt;Run buildspec.yml&lt;br&gt;Check git diff → detect changed services" style="text;html=1;strokeColor=#7986CB;fillColor=#283593;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="610" y="195" width="150" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p2_arrow4" value="git diff HEAD~1&lt;br&gt;detect changed dirs" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#FF8C00;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#B45309;" parent="1" source="p2_codebuild" target="p2_condition" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_condition" value="&lt;b&gt;Service Changed?&lt;/b&gt;&lt;br&gt;Check source dir" style="rhombus;whiteSpace=wrap;html=1;fillColor=#7B6000;strokeColor=#FFD54F;fontColor=#FFFFFF;fontSize=12;fontStyle=1;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="870" y="70" width="160" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p2_condition_note" value="&lt;b&gt;5. Condition Check&lt;/b&gt;&lt;br&gt;Loop qua từng service dir:&lt;br&gt;• main-service/&lt;br&gt;• notification-service/&lt;br&gt;• envoy-proxy/&lt;br&gt;Nếu có thay đổi → build" style="text;html=1;strokeColor=#FFD54F;fillColor=#7B6000;fontColor=#FFFFFF;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="840" y="220" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p2_arrow5" value="YES: Service changed" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#00C853;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#1B5E20;" parent="1" source="p2_condition" target="p2_build_image" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_arrow5b" value="NO: Skip service" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=#FF5252;strokeWidth=2;fontStyle=1;fontSize=11;dashed=1;fontColor=#FFFFFF;labelBackgroundColor=#B71C1C;endArrow=none;" parent="1" source="p2_condition" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="950" y="340"/>
                            <mxPoint x="1280" y="340"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p2_build_image" value="&lt;b&gt;Build Docker Image&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;fontSize=13;fontStyle=1;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="95" width="160" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p2_build_image_label" value="&lt;b&gt;6. Build Docker Image&lt;/b&gt;&lt;br&gt;docker build -t &lt;service&gt;:&lt;commit-sha&gt;&lt;br&gt;Tạo image cho service thay đổi" style="text;html=1;strokeColor=#FFB300;fillColor=#E65100;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1075" y="195" width="210" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p2_arrow6" value="docker push&lt;br&gt;&lt;ecr-uri&gt;/&lt;service&gt;:&lt;sha&gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#FF8C00;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#B45309;" parent="1" source="p2_build_image" target="p2_ecr" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_ecr" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" parent="1" vertex="1">
                    <mxGeometry x="1145" y="380" width="70" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p2_ecr_label" value="&lt;b&gt;7. Amazon ECR&lt;/b&gt;&lt;br&gt;Store Docker images&lt;br&gt;Tag: &lt;commit-sha&gt; &amp; latest" style="text;html=1;strokeColor=#FFB300;fillColor=#BF360C;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1110" y="470" width="140" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p2_arrow7" value="imagedefinitions.json&lt;br&gt;→ Deploy stage" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#FF8C00;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#FFFFFF;labelBackgroundColor=#B45309;" parent="1" source="p2_ecr" target="p2_ecs" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_ecs" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs;" parent="1" vertex="1">
                    <mxGeometry x="1145" y="640" width="70" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p2_ecs_label" value="&lt;b&gt;8. Amazon ECS (Fargate)&lt;/b&gt;&lt;br&gt;Update Service with new image&lt;br&gt;Rolling deployment → zero downtime" style="text;html=1;strokeColor=#FFB300;fillColor=#BF360C;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="730" width="160" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p2_legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;─── Normal flow&lt;br&gt;&lt;font color=&quot;#00C853&quot;&gt;─── Service changed (build)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FF5252&quot;&gt;- - - No change (skip)&lt;/font&gt;" style="text;html=1;strokeColor=#AAAAAA;fillColor=#212121;fontColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;spacingLeft=10;spacingTop=5;" parent="1" vertex="1">
                    <mxGeometry x="50" y="650" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p2_summary" value="&lt;b&gt;📌 Flow Summary&lt;/b&gt;&lt;br&gt;1. Developer push code lên GitHub (main branch)&lt;br&gt;2. GitHub Webhook trigger AWS CodePipeline&lt;br&gt;3. CodePipeline chạy Build stage → gọi CodeBuild&lt;br&gt;4. CodeBuild đọc buildspec.yml, chạy git diff&lt;br&gt;5. Với mỗi service dir có thay đổi:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;a. Build Docker image mới&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;b. Push image lên ECR với tag commit SHA&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;c. Tạo imagedefinitions.json&lt;br&gt;6. CodePipeline chạy Deploy stage&lt;br&gt;7. ECS Fargate rolling update với image mới" style="text;html=1;strokeColor=#42A5F5;fillColor=#0D47A1;fontColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="50" y="380" width="340" height="250" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
