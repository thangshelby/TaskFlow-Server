  },
  "Redis": {
    "ConnectionString": "taskflow-xo6njz.serverless.apse1.cache.amazonaws.com:6379,ssl=true,abortConnect=false"
  },
  "KafkaHost": "localhost:29092",
  "ActivitiesTopicName": "activities",
